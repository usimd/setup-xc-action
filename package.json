{
  "name": "setup-xc-action",
  "version": "1.0.1",
  "description": "GitHub Action to setup Microchip XC compilers",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "npm run typecheck && ncc build src/main.ts -m --no-source-map-register --license licenses.txt",
    "typecheck": "./node_modules/@typescript/native/bin/tsc --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "format": "prettier --write '**/*.ts'",
    "format-check": "prettier --check '**/*.ts'",
    "lint": "eslint src/**/*.ts __tests__/**/*.ts",
    "lint:fix": "eslint src/**/*.ts __tests__/**/*.ts --fix",
    "package": "npm run build",
    "all": "npm run format && npm run lint && npm run test && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/usimd/setup-xc-action.git"
  },
  "keywords": [
    "actions",
    "microchip",
    "xc8",
    "xc16",
    "xc32",
    "compiler",
    "embedded"
  ],
  "author": "usimd",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^3.0.0",
    "@actions/exec": "^3.0.0",
    "@actions/tool-cache": "^4.0.0",
    "@actions/http-client": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^26.0.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vercel/ncc": "^0.45.0",
    "@vitest/coverage-v8": "^5.0.0",
    "@vitest/eslint-plugin": "^1.0.0",
    "eslint": "^10.0.0",
    "prettier": "^3.1.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.14.0",
    "vitest": "^5.0.0"
  }
}
